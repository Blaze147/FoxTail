<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate x:Key="RuleTemplate">
        <StackPanel Orientation="Horizontal" Margin="4,8">
            <TextBlock Margin="0,0,8,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="●"/>
                        <Setter Property="Foreground" Value="#86CFC1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                <Setter Property="Text" Value="○"/>
                                <Setter Property="Foreground" Value="#60748B"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Name}"/>
        </StackPanel>
    </DataTemplate>
    <Style TargetType="Window">
        <Setter Property="Background" Value="#101720"/>
        <Setter Property="Foreground" Value="#D7E0EA"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="#E8EEF5"/>
        <Setter Property="Background" Value="#283443"/>
        <Setter Property="BorderBrush" Value="#3E5063"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#3C5065"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#1A2735"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#F3A76C"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#0B111A"/>
        <Setter Property="Foreground" Value="#D7E0EA"/>
        <Setter Property="CaretBrush" Value="#F3A76C"/>
        <Setter Property="BorderBrush" Value="#60748B"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Margin" Value="0,5,0,0"/>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="#D7E0EA"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="4,0,0,0"/>
    </Style>
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="#0B111A"/>
        <Setter Property="Foreground" Value="#D7E0EA"/>
        <Setter Property="BorderBrush" Value="#283443"/>
    </Style>
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="#0B111A"/>
        <Setter Property="BorderBrush" Value="#283443"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="#D7E0EA"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBorder" Background="#18232F" Padding="14,10" BorderThickness="0,0,0,2" BorderBrush="Transparent" Margin="0,0,4,0">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="#F3A76C"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#283443"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
